//-----------------------------------------------------------------------------
//	CLIENT_HL2MP.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"sdk" [!$SOURCESDK]
$Macro GAMENAME 	"mod_sdk" [$SOURCESDK]

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;sdk\vgui,.\sdk,$SRCDIR\game\shared\sdk,$SRCDIR\game\shared\multiplayer,.\hl2,.\hl2\elements,$SRCDIR\game\shared\hl2"
		$PreprocessorDefinitions			"$BASE;SDK;SDK_DLL;NEXT_BOT"
	}
}

$Project "Client (SDK MP Game Template)"
{
	$Folder	"Source Files"
	{
		-$File	"$SRCDIR\game\shared\weapon_parse_default.cpp"

		$File	"c_team_objectiveresource.cpp"
		$File	"c_team_objectiveresource.h"
		$File	"c_team_train_watcher.cpp"
		$File	"c_team_train_watcher.h"
		$File	"hud_voicestatus.cpp"
		$File	"$SRCDIR\game\shared\predicted_viewmodel.cpp"
		$File	"$SRCDIR\game\shared\predicted_viewmodel.h"
		$File	"$SRCDIR\game\shared\teamplay_round_timer.cpp"
		$File	"$SRCDIR\game\shared\teamplay_round_timer.h"

		$Folder	"NextBot"
		{
			$File	"NextBot\C_NextBot.cpp"
			$File	"NextBot\C_NextBot.h"
		}

		$Folder	"SDK"
		{
			$File	"sdk\c_sdk_env_sparkler.cpp"
			$File	"sdk\c_te_firebullets.cpp"
			$File	"hl2\c_waterbullet.cpp"
