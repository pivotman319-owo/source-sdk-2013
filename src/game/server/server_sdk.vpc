$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"sdk" [!$SOURCESDK]
$Macro GAMENAME 	"mod_sdk" [$SOURCESDK]

$Include "$SRCDIR\game\server\server_base.vpc"
$Include "$SRCDIR\game\server\nav_mesh.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\hl2,.\hl2,.\hl2mp,$SRCDIR\game\shared\hl2mp"
		$PreprocessorDefinitions		"$BASE;SDK;SDK_DLL;NEXT_BOT"
	}
}

